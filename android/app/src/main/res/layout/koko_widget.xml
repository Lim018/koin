<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 home widget: Koko's mood, today's spending, progress and "+ TAMBAH".
     Only RemoteViews-safe views are used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/koko"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/widget_koko_bg"
            android:contentDescription="Koko senang"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/koko_happy" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Hari ini"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Sisa 200rb"
                android:textColor="@color/sage_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/amount"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:autoSizeMaxTextSize="28sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeTextType="uniform"
        android:fontFeatureSettings="tnum"
        android:gravity="center_vertical"
        android:letterSpacing="-0.03"
        android:maxLines="1"
        android:text="Rp 0"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="4dp">

        <ProgressBar
            android:id="@+id/progress_under"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_under" />

        <ProgressBar
            android:id="@+id/progress_over"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/widget_progress_over"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Absorbs extra height when the widget is resized taller.
         (FrameLayout, not View: plain View is not RemoteViews-safe pre-31.) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="8dp" />

    <TextView
        android:id="@+id/btn_add"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/widget_button"
        android:contentDescription="Tambah pengeluaran"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:text="+  TAMBAH"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
